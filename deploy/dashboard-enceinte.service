[Unit]
Description=Dashboard Enceinte (interface web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
# amixer a besoin du groupe audio pour piloter le volume de la carte.
SupplementaryGroups=audio
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/default/enceinte
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/run.py

# Le dashboard cede le CPU aux services audio en cas de contention : c'est lui
# qui, en interrogeant les services en boucle, provoquait des craquements.
Nice=10

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
