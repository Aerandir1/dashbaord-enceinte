# Configuration partagee des services de l'enceinte.
# Installee vers /etc/default/enceinte  (editez ce fichier, puis :
#   sudo systemctl restart dashboard-enceinte librespot shairport-sync)

# --- Dashboard web ---
SECRET_KEY=change-me
FLASK_HOST=0.0.0.0
# NE PAS utiliser 5000 : ce port est celui du RTSP d'AirPlay (shairport-sync).
FLASK_PORT=5001
FLASK_DEBUG=false
# Ignore par le service systemd : waitress ne fait pas de TLS. Le dashboard
# n'utilise aucune API navigateur exigeant HTTPS (le spectre est calcule cote
# serveur). Pour du HTTPS, placez un reverse proxy (nginx/Caddy) devant.
FLASK_SSL=false

# Serveur WSGI (waitress). Chaque onglet ouvert consomme un thread pour le flux
# SSE : gardez une marge confortable par rapport au nombre d'onglets attendus.
WAITRESS_THREADS=16
# Doit rester superieur au heartbeat SSE (25 s) pour ne pas couper les clients.
WAITRESS_CHANNEL_TIMEOUT=300

# --- Sortie audio (partagee par les deux services) ---
# "default" = le dmix defini dans /etc/asound.conf, cale sur 44100 Hz : la
# carte est partageable entre AirPlay et Spotify, sans reechantillonnage.
# N'utilisez PAS hw:N ici : l'acces materiel direct est exclusif, le premier
# service qui ouvre la carte rendrait l'autre muet.
ALSA_DEVICE=default
# Controle ALSA du volume. Vide = detection auto (Master, puis Digital, PCM...).
# Un HiFiBerry DAC+ expose son volume sous le nom "Digital", pas "Master".
ALSA_MIXER_CONTROL=
ALSA_MIXER_CARD=

# --- Source audio ---
# Une seule source peut etre active a la fois (AirPlay et Spotify se disputent
# la carte son). Celle-ci demarre automatiquement au boot ; l'autre est lancee
# a la demande depuis le dashboard, ce qui arrete la premiere.
# Valeurs : spotify | airplay
DEFAULT_SOURCE=spotify

# --- Noms annonces sur le reseau ---
# AIRPLAY_NAME n'est lu qu'a l'installation (il est ecrit dans
# /etc/shairport-sync.conf) : apres modification, relancez deploy/install.sh.
AIRPLAY_NAME="Enceinte Salon"

# --- Spotify Connect (librespot) ---
SPOTIFY_NAME="Enceinte Salon"
SPOTIFY_BITRATE=320

# --- Pilotage des services par le dashboard (systemd) ---
SERVICE_MANAGER=systemd
SHAIRPORT_SYNC_SERVICE=shairport-sync
SHAIRPORT_SYNC_SYSTEMD_USER=false
SHAIRPORT_SYNC_USE_SUDO=true
LIBRESPOT_SERVICE=librespot
LIBRESPOT_SYSTEMD_USER=false
LIBRESPOT_USE_SUDO=true
SHAIRPORT_METADATA_PIPE=/tmp/shairport-sync-metadata

# Relais des logs shairport-sync dans la console du dashboard.
SHAIRPORT_LOG_TO_SERVER_CONSOLE=false

# Duree de cache de l'etat systeme (services + volume), en secondes.
# Trop bas = interrogation permanente des services = craquements audio.
STATE_CACHE_TTL_SECONDS=3.0

# --- Reverse proxy nginx (optionnel) ---
# true = installe nginx qui sert un ecran de chargement INSTANTANE au demarrage
# (tant que waitress n'est pas pret) puis proxifie le dashboard sur le port 80.
# L'acces direct au port ci-dessus reste possible. Debloque aussi le passage
# futur en HTTPS (donc le Service Worker de peinture instantanee).
ENABLE_NGINX=false
