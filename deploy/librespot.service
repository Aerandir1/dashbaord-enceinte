[Unit]
Description=librespot (Spotify Connect) pour l'enceinte
Documentation=https://github.com/librespot-org/librespot
After=network-online.target sound.target avahi-daemon.service
Wants=network-online.target

# Une seule source audio a la fois : demarrer librespot arrete shairport-sync.
# Declare a systemd, l'exclusivite tient meme si un service est demarre a la
# main, hors du dashboard.
Conflicts=shairport-sync.service

# Garde-fou : si les deux services devaient malgre tout se relancer
# mutuellement, systemd coupe court au bout de 5 demarrages en 60 s au lieu de
# laisser tourner un ping-pong indefini.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@RUN_USER@
# Acces a la carte son via ALSA.
SupplementaryGroups=audio

# Valeurs par defaut, surchargees ensuite par /etc/default/enceinte : l'unite
# demarre meme si une cle manque au fichier.
Environment=SPOTIFY_NAME=Enceinte
Environment=SPOTIFY_BITRATE=320
Environment=ALSA_DEVICE=hw:0
Environment=LIBRESPOT_METADATA_FILE=/run/enceinte/spotify-metadata.json
EnvironmentFile=/etc/default/enceinte

# Cree /run/enceinte (proprietaire = User=) pour le fichier de metadonnees,
# et le supprime a l'arret : le dashboard cesse alors d'afficher un titre
# obsolete si librespot s'arrete.
RuntimeDirectory=enceinte
RuntimeDirectoryMode=0755

# ATTENTION : pas d'ordonnancement temps reel ici (contrairement a
# shairport-sync). librespot est une application asynchrone (tokio) dont tous
# les threads - reseau et TLS compris - heriteraient de SCHED_FIFO. Sur un Pi 3
# ils se starvent mutuellement : le websocket Spotify tombe en boucle et
# librespot finit sur "device became inactive". Il tamponne largement en amont,
# la priorite temps reel lui est donc inutile.
ExecStart=/usr/local/bin/librespot \
    --name "${SPOTIFY_NAME}" \
    --bitrate ${SPOTIFY_BITRATE} \
    --backend alsa \
    --device ${ALSA_DEVICE} \
    --cache /var/cache/librespot \
    --onevent /usr/local/bin/librespot-event.sh

# PAS "always" : combine a Conflicts=, il ressuscitait librespot juste apres
# que shairport-sync l'ait arrete, ce qui arretait shairport-sync a son tour --
# les deux services se relancaient en boucle indefiniment. "on-failure" ne
# redemarre qu'apres un vrai plantage, jamais apres un arret propre.
# (C'est aussi le reglage du paquet Debian de shairport-sync.)
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
