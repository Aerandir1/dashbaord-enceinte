# Configuration du conteneur Docker (dashboard + librespot + shairport-sync).
# Copier en .env puis décommenter `env_file` dans docker-compose.yml.

# --- Dashboard web ---
SECRET_KEY=change-me
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
# HTTPS auto-signé (nécessaire pour la capture micro navigateur). true/false.
FLASK_SSL=false

# --- Sortie audio (ALSA) ---
# Périphérique ALSA partagé par librespot et shairport-sync.
# Exemples : default, hw:0, plughw:1,0 (voir `aplay -l` sur l'hôte).
# Viser le DAC en direct (hw:0) évite le rééchantillonnage dmix.
ALSA_DEVICE=hw:0

# Contrôle ALSA du volume. Vide = détection auto (Master, puis Digital, PCM…).
# Un HiFiBerry DAC+ expose son volume sous le nom "Digital", pas "Master".
ALSA_MIXER_CONTROL=
# Carte du mixer (vide = carte par défaut). Ex : 0
ALSA_MIXER_CARD=

# --- Spotify Connect (librespot) ---
SPOTIFY_NAME=Enceinte Spotify
SPOTIFY_BITRATE=320
SPOTIFY_AUTOSTART=true
# Arguments librespot supplémentaires (ex : --initial-volume 50 --volume-ctrl linear)
LIBRESPOT_EXTRA_ARGS=

# --- AirPlay (shairport-sync) ---
AIRPLAY_NAME=Enceinte AirPlay
AIRPLAY_AUTOSTART=true

# --- Interne (ne pas modifier en général) ---
# SERVICE_MANAGER=supervisor
# SHAIRPORT_METADATA_PIPE=/tmp/shairport-sync-metadata
